---
interface Props {
  title: string;
  publication?: string;
  year?: number;
  authors: string;
  pdfUrl?: string;
  doi?: string;
}

const { title, publication, year, authors, pdfUrl, doi } = Astro.props;
const publicationDetails = [publication, year].filter((value) => value !== undefined).join(', ');
---

<div class="card">
  <div class="w-full flex justify-between items-start mb-2">
    <div class="min-w-0 pr-4">
      {publicationDetails && <p class="text-gray-300 italic text-sm">{publicationDetails}</p>}
      {
        doi ? (
          <a class="block font-semibold hover:underline" href={doi} rel="noreferrer noopener" target="_blank">
            {title}
          </a>
        ) : (
          <p class="font-semibold">{title}</p>
        )
      }
    </div>
    {
      pdfUrl && (
        <a class="btn text-xs" href={`/research/${pdfUrl}`}>
          PDF
        </a>
      )
    }
  </div>
  <p>
    {authors}
  </p>
</div>
