---
import * as marked from 'marked';
import sanitizeHtml from 'sanitize-html';
import type { Tokens } from 'marked';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  link?: string;
  imageUrl?: ImageMetadata;
}

const { title, description, link, imageUrl } = Astro.props;

const renderer = {
  link(token: Tokens.Link): string {
    const { href, title, text } = token;
    return `<a class="link" href="${href}" title="${title ?? text}" target="_blank">${text}</a>`;
  },
};

marked.use({ renderer });

const parsedDescription = await marked.parse(description);
const sanitisedDescription = sanitizeHtml(parsedDescription, {
  allowedAttributes: {
    a: ['href', 'class', 'target'],
  },
});
---

<article class="card">
  <div class="mb-3 flex w-full items-start justify-between gap-4">
    <h3>{title}</h3>
    {
      link && (
        <a class="btn shrink-0 text-xs" href={link} target="_blank" rel="noreferrer noopener">
          Link
        </a>
      )
    }
  </div>

  <div class="flex flex-col gap-5 xs:flex-row xs:gap-6">
    <div
      class="aspect-square w-full shrink-0 self-start overflow-hidden rounded-md border border-gray-400 bg-white xs:w-38 sm:w-42"
    >
      {
        imageUrl ? (
          <Image
            class="h-full w-full object-contain"
            src={imageUrl}
            alt={`${title} cover`}
            widths={[416, 624]}
            sizes="(min-width: 640px) 208px, calc(100vw - 48px)"
          />
        ) : (
          <div class="flex h-full w-full flex-col items-center justify-center gap-2 bg-white text-gray-300">
            <svg
              class="size-9"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.25"
              aria-hidden="true"
            >
              <path d="M4 5.5A1.5 1.5 0 0 1 5.5 4h13A1.5 1.5 0 0 1 20 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-13A1.5 1.5 0 0 1 4 18.5z" />
              <path d="m7 16 3.25-3.25 2.5 2.5L15 13l2 2M8.5 9.5h.01" />
            </svg>
          </div>
        )
      }
    </div>

    <div class="min-w-0 flex-1 text-gray-200" set:html={sanitisedDescription} />
  </div>
</article>
