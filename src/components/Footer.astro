---
import SocialLinks from './SocialLinks.astro';
import { SITE_NAME } from '../consts';
const currentPath = Astro.url.pathname;
---

<footer class="pt-2">
  <div class:list={['border-t border-gray-400/30']}>
    <div
      class:list={[
        'mx-auto flex items-center px-6 max-w-4xl',
        currentPath === '/' ? 'justify-center' : 'justify-between',
      ]}
    >
      <p class="py-3 text-sm">&copy; 2023 - {new Date().getFullYear()}&nbsp;{SITE_NAME}</p>
      {currentPath !== '/' && <SocialLinks />}
    </div>
  </div>
</footer>
