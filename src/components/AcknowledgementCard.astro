---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  firstName: string;
  lastName?: string;
  description?: string;
  logoUrl?: ImageMetadata;
}

const { firstName, lastName, description, logoUrl } = Astro.props;
const name = `${firstName} ${lastName ? lastName.toUpperCase() : ''}`.trim();
---

<div class="flex items-start gap-2.5">
  {
    logoUrl && (
      <div class="flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-gray-400/30 bg-white p-1 shadow-2xs">
        <Image class="h-full w-full object-contain" src={logoUrl} alt={`${name} logo`} widths={[44, 88]} sizes="44px" />
      </div>
    )
  }
  <div class="min-w-0">
    <h4 class="leading-6">{name}</h4>
    {description && <p class="-mt-0.5 text-sm leading-4 text-gray-300 italic">{description}</p>}
  </div>
</div>
